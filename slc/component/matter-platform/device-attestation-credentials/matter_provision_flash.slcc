id: matter_provision_flash
label: Flash Factory Data Reader
description: Reads factory/manufacturing data and device attestation credentials from a dedicated flash storage backend. Use this when the application only needs to consume provisioned data at runtime. Set SL_MATTER_ENABLE_EXAMPLE_CREDENTIALS to fall back to hardcoded test certificates when factory credentials are missing. Add matter_provision_channel when factory data must also be written during manufacturing.
package: matter
category: Platform|Security
quality: production
metadata:
  sbom:
    license: Zlib
provides:
  - name: matter_provision
  - name: matter_provision_flash

requires:
  - name: matter_crypto_siwx917
    condition: [device_family_siwg917]

conflicts:
  - name: matter_provision_default

define:
  - name: SL_MATTER_USE_FLASH_STORE
    value: 1

config_file:
  - path: slc/config/sl_matter_provision_config.h
    file_id: matter_provision_config

include:
  - path: third_party/matter_support/provision
    file_list:
      - path: headers/ProvisionChannelInterface.h
      - path: headers/ProvisionCryptoInterface.h
      - path: headers/ProvisionEncoder.h
      - path: headers/ProvisionManager.h
      - path: headers/ProvisionProtocol.h
      - path: headers/ProvisionStorage.h
      - path: headers/ProvisionStorageGeneric.h
      - path: headers/ProvisionStorageInterfaces.h
  - path: third_party/matter_sdk/examples/platform/silabs
    file_list:
      - path: provision/ProvisionCrypto.h
      - path: provision/ProvisionStorageReader.h
      - path: provision/flash/ProvisionStorageFlash.h

source:
  - path: third_party/matter_sdk/examples/platform/silabs/provision/flash/ProvisionStorageReader.cpp
  - path: third_party/matter_sdk/examples/platform/silabs/provision/flash/ProvisionStorageFlash.cpp
  - path: third_party/matter_sdk/examples/platform/silabs/provision/ProvisionStorageReaderCommon.cpp
  - path: third_party/matter_sdk/examples/platform/silabs/provision/ProvisionCryptoPSA.cpp
    unless: [matter_crypto_tinycrypt_siwx917]
  - path: third_party/matter_sdk/examples/platform/silabs/provision/ProvisionCryptoMbed.cpp
    condition: [matter_crypto_tinycrypt_siwx917]

library:
  # Flash storage always requires the proprietary provision library (ABI-keyed).
  - path: third_party/matter_support/provision/libs/libProvision-m33-hard.a
    condition: [matter_platform_mg]
    unless: [toolchain_llvm]
  - path: third_party/matter_support/provision/libs/libProvision-m33-hard-clang.a
    condition:
      - matter_platform_mg
      - toolchain_llvm
  - path: third_party/matter_support/provision/libs/libProvision-m4-softfp.a
    condition: [device_family_siwg917]
    unless: [toolchain_llvm]
  - path: third_party/matter_support/provision/libs/libProvision-m4-softfp-clang.a
    condition:
      - device_family_siwg917
      - toolchain_llvm

template_contribution:
  # Series-3 will use common token manager.
  # It is not yet available but we need this to align with zigbee stack pulling the token manager.
  # This is done so our CMP app flash placement matches our other Matter apps on S3
  # The result is the last 2 pages of flash are reserved for token/matter_credentials
  - name: static_tokens_enable
    value: 1
    condition: [device_series_3]
  - name: lockbits_size
    value: 8192
    condition: [device_series_3]
