id: matter_provision_default
label: Default Factory Data Reader
description: Reads factory/manufacturing data and device attestation credentials from the default (NVM3/token) storage backend. Use this when the application only needs to consume provisioned data at runtime. Set SL_MATTER_ENABLE_EXAMPLE_CREDENTIALS to fall back to hardcoded test certificates when factory credentials are missing. Add matter_provision_channel when factory data must also be written during manufacturing.
package: matter
category: Platform|Security
quality: production
metadata:
  sbom:
    license: Zlib

provides:
  - name: matter_provision
  - name: matter_provision_default

config_file:
  - path: slc/config/sl_matter_provision_config.h
    file_id: matter_provision_config

define:
  - name: SL_MATTER_USE_FLASH_STORE
    value: 0

requires:
  # Provisioning Default only support PSA crypto flavor
  - name: matter_crypto_psa_siwx917
    condition: [device_family_siwg917]

conflicts:
  - name: matter_provision_flash

include:
  - path: third_party/matter_support/provision
    file_list:
      - path: headers/ProvisionChannelInterface.h
      - path: headers/ProvisionCryptoInterface.h
      - path: headers/ProvisionEncoder.h
      - path: headers/ProvisionManager.h
      - path: headers/ProvisionProtocol.h
      - path: headers/ProvisionStorage.h
      - path: headers/ProvisionStorageGeneric.h
      - path: headers/ProvisionStorageInterfaces.h
  - path: third_party/matter_sdk/examples/platform/silabs
    file_list:
      - path: provision/ProvisionCrypto.h
      - path: provision/ProvisionStorageReader.h

source:
  - path: third_party/matter_sdk/examples/platform/silabs/provision/default/ProvisionStorageReader.cpp
  - path: third_party/matter_sdk/examples/platform/silabs/provision/ProvisionStorageReaderCommon.cpp
  - path: third_party/matter_sdk/examples/platform/silabs/provision/ProvisionCryptoPSA.cpp
